<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".presentation.screen.income.IncomeFragment">

    <!-- Основной контент -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Заголовок экрана -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Доходы"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <!-- Общий бюджет / остаток -->
        <TextView
            android:id="@+id/tvBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Бюджет: 0 ₽"
            android:textSize="18sp"
            android:paddingBottom="8dp"/>

        <!-- Расходы за месяц -->
        <TextView
            android:id="@+id/tvMonthIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Доходы за месяц: 0 ₽"
            android:textSize="16sp"
            android:paddingBottom="16dp"/>

        <!-- Заголовок списка транзакций -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Последние транзакции:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <!-- Список транзакций -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTransactions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_transaction"/>

        <!-- Кнопка загрузки следующих транзакций -->
        <Button
            android:id="@+id/btnLoadMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Загрузить ещё"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            style="?attr/materialButtonOutlinedStyle"/>

    </LinearLayout>

    <!-- Плавающая кнопка добавления расхода -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddIncome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Добавить доход"
        android:src="@android:drawable/ic_input_add" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>
