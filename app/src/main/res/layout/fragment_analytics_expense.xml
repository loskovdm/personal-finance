<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Общая сумма -->
            <TextView
                android:id="@+id/tvTotalExpenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Общие расходы: 0 ₽"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="16dp" />

            <!-- Круговая диаграмма -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Распределение расходов"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/chartExpense"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="16dp" />

            <!-- Сообщение при отсутствии данных -->
            <TextView
                android:id="@+id/tvNoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Нет данных о расходах за выбранный период"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone" />

            <!-- Детализация по категориям -->
            <TextView
                android:id="@+id/tvDetailsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Детализация по категориям:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <!-- Контейнер для детализации -->
            <LinearLayout
                android:id="@+id/llCategoryDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>